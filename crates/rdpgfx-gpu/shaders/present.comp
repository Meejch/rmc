#version 450
// Present: one dispatch per visible surface piece. Every view (swapchain) pixel whose
// centre maps into the piece gets the surface pixels of its footprint: exact at scale 1,
// box filter when downscaling (windowed mode), nearest when upscaling.
// Same transformation as rdpgfx_model::outputs::ViewTransform.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform writeonly image2D target;            // swapchain (BGRA)
layout(set = 0, binding = 1, r32ui) uniform readonly uimage2D surface_px; // BGRA bytes per uint

layout(push_constant) uniform Params {
    uvec4 dst;       // dispatch rectangle in view pixels (l, t, r, b)
    uvec4 piece;     // visible part of the surface in session coordinates (l, t, r, b)
    ivec2 viewport;  // session coordinates of the viewport origin
    ivec2 origin;    // session coordinates of the surface origin
    vec2 offset;     // letterbox offset in view pixels
    float scale;     // view pixels per session pixel
    uint pad0;
} pc;

vec3 texel(ivec2 p) {
    uint v = imageLoad(surface_px, p).x;
    return vec3(float((v >> 16) & 255u), float((v >> 8) & 255u), float(v & 255u));
}

void main() {
    uvec2 px = pc.dst.xy + gl_GlobalInvocationID.xy;
    if (px.x >= pc.dst.z || px.y >= pc.dst.w) return;
    vec2 p = vec2(px);
    vec2 centre = vec2(pc.viewport) + (p + 0.5 - pc.offset) / pc.scale;
    if (centre.x < float(pc.piece.x) || centre.y < float(pc.piece.y) ||
        centre.x >= float(pc.piece.z) || centre.y >= float(pc.piece.w)) return;

    // Footprint in surface coordinates, limited to the piece.
    vec2 lo = vec2(pc.piece.xy) - vec2(pc.origin);
    vec2 hi = vec2(pc.piece.zw) - vec2(pc.origin) - 1.0;
    vec3 rgb;
    if (pc.scale >= 0.999) {
        ivec2 t = ivec2(clamp(floor(centre - vec2(pc.origin)), lo, hi));
        rgb = texel(t);
    } else {
        vec2 a = vec2(pc.viewport) + (p - pc.offset) / pc.scale - vec2(pc.origin);
        vec2 b = vec2(pc.viewport) + (p + 1.0 - pc.offset) / pc.scale - vec2(pc.origin);
        ivec2 i0 = ivec2(clamp(floor(a + 1e-3), lo, hi));
        ivec2 i1 = ivec2(clamp(ceil(b - 1e-3) - 1.0, lo, hi));
        vec3 sum = vec3(0.0);
        for (int y = i0.y; y <= i1.y; y++)
            for (int x = i0.x; x <= i1.x; x++)
                sum += texel(ivec2(x, y));
        rgb = sum / float((i1.x - i0.x + 1) * (i1.y - i0.y + 1));
        rgb = floor(rgb + 0.5);
    }
    imageStore(target, ivec2(px), vec4(rgb / 255.0, 1.0));
}
