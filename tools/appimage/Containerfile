# Build environment of the RMC AppImage: Ubuntu 22.04 (glibc 2.35), so the AppImage runs on
# Ubuntu 22.04+, Debian 12+, Fedora 36+ and other current distributions.
FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git pkg-config nasm curl ca-certificates xz-utils file patch \
      clang libclang-dev patchelf squashfs-tools desktop-file-utils glslang-tools \
      libssl-dev libkrb5-dev libcjson-dev liburiparser-dev \
      libpulse-dev libcups2-dev libv4l-dev libusb-1.0-0-dev libopus-dev libva-dev libdrm-dev \
      libx11-dev libxext-dev libxfixes-dev libxrandr-dev libxi-dev libxkbcommon-dev libwayland-dev \
      libwebkit2gtk-4.1-dev libgtk-3-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:$PATH
